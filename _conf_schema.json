{
  "checkin_mode": {
    "description": "打卡积分模式",
    "type": "string",
    "options": [
      "fixed",
      "random",
      "custom"
    ],
    "labels": [
      "固定积分",
      "随机区间",
      "自定义列表"
    ],
    "default": "fixed",
    "hint": "和插件页「打卡规则」里的积分模式是同一份配置：这里保存会热重载插件并覆盖插件页，插件页保存会回写到这里。"
  },
  "checkin_fixed": {
    "description": "固定积分（每次打卡获得）",
    "type": "int",
    "default": 10,
    "slider": {
      "min": 0,
      "max": 1000,
      "step": 1
    }
  },
  "checkin_random_min": {
    "description": "随机积分下限",
    "type": "int",
    "default": 5
  },
  "checkin_random_max": {
    "description": "随机积分上限",
    "type": "int",
    "default": 20
  },
  "checkin_custom_points": {
    "description": "自定义积分列表",
    "type": "list",
    "default": [
      5,
      10,
      20
    ],
    "hint": "例如 [5, 10, 20]。"
  },
  "checkin_custom_weights": {
    "description": "自定义积分权重",
    "type": "list",
    "default": [],
    "hint": "留空表示等概率；填了就必须与积分列表一一对应，例如 [1, 3, 1]。"
  },
  "streak_bonus_enabled": {
    "description": "启用连签奖励",
    "type": "bool",
    "default": true
  },
  "streak_bonus_every": {
    "description": "连签奖励间隔（天）",
    "type": "int",
    "default": 7
  },
  "streak_bonus_points": {
    "description": "连签奖励积分",
    "type": "int",
    "default": 50
  },
  "reset_hour": {
    "description": "每日重置小时",
    "type": "int",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 23,
      "step": 1
    },
    "hint": "填 4 表示凌晨 0:00~3:59 仍算前一天，适合夜间活跃的群。"
  },
  "leaderboard_size": {
    "description": "积分榜长度",
    "type": "int",
    "default": 20,
    "slider": {
      "min": 1,
      "max": 100,
      "step": 1
    }
  },
  "leaderboard_scope": {
    "description": "积分榜范围",
    "type": "string",
    "options": [
      "platform",
      "global"
    ],
    "labels": [
      "本平台",
      "全平台"
    ],
    "default": "platform"
  },
  "points_scope": {
    "description": "积分作用域",
    "type": "string",
    "options": [
      "platform_user",
      "conversation"
    ],
    "labels": [
      "同平台用户共享",
      "按会话隔离"
    ],
    "default": "platform_user",
    "hint": "当前版本实际按「同平台用户共享」记账；该选项预留给会话隔离模式。"
  },
  "confirm_timeout_seconds": {
    "description": "兑换确认超时（秒）",
    "type": "int",
    "default": 60,
    "slider": {
      "min": 10,
      "max": 600,
      "step": 10
    }
  },
  "shop_title": {
    "description": "商店标题",
    "type": "string",
    "default": "积分商店"
  },
  "shop_subtitle": {
    "description": "商店副标题",
    "type": "string",
    "default": "引用确认消息并回复 是/否 即可完成兑换"
  },
  "email_enabled": {
    "description": "启用兑换发放邮件通知",
    "type": "bool",
    "default": false,
    "hint": "开启后，在插件页把兑换记录标记为「已发放」时，会给用户发一封 SMTP 邮件（同时仍会私聊/会话通知）。"
  },
  "email_smtp_host": {
    "description": "SMTP 服务器",
    "type": "string",
    "default": "",
    "hint": "例如 smtp.qq.com、smtp.163.com、smtp.gmail.com。"
  },
  "email_smtp_port": {
    "description": "SMTP 端口",
    "type": "int",
    "default": 465,
    "hint": "SSL 常用 465，STARTTLS 常用 587。"
  },
  "email_smtp_encryption": {
    "description": "SMTP 加密方式",
    "type": "string",
    "options": [
      "ssl",
      "starttls",
      "none"
    ],
    "labels": [
      "SSL/TLS（465）",
      "STARTTLS（587）",
      "不加密（25，不推荐）"
    ],
    "default": "ssl"
  },
  "email_smtp_user": {
    "description": "SMTP 账号",
    "type": "string",
    "default": "",
    "hint": "通常填完整邮箱地址。"
  },
  "email_smtp_password": {
    "description": "SMTP 密码 / 授权码",
    "type": "string",
    "secret": true,
    "default": "",
    "hint": "QQ 邮箱、163 等要填「授权码」，不是登录密码。"
  },
  "email_sender": {
    "description": "发件人地址",
    "type": "string",
    "default": "",
    "hint": "留空则用 SMTP 账号。"
  },
  "email_recipient_suffix": {
    "description": "收件人默认后缀",
    "type": "string",
    "default": "@qq.com",
    "hint": "用户没绑定邮箱时，用「QQ 号 + 这个后缀」当收件地址；留空表示不做这种推断。"
  },
  "email_fallback_to": {
    "description": "兜底收件人",
    "type": "string",
    "default": "",
    "hint": "推不出用户邮箱时把邮件发到这里（例如管理员邮箱）；留空则该次不发。"
  },
  "render_width": {
    "description": "卡片宽度（像素）",
    "type": "int",
    "default": 1080,
    "slider": {
      "min": 640,
      "max": 1600,
      "step": 20
    }
  },
  "render_font_size_base": {
    "description": "卡片基础字号",
    "type": "int",
    "default": 0,
    "hint": "0 表示按卡片宽度自动计算。"
  },
  "render_font_path": {
    "description": "自定义字体路径",
    "type": "string",
    "default": "",
    "hint": "留空使用插件内置的 Noto Sans CJK SC；填系统字体路径可覆盖（例如 C:\\Windows\\Fonts\\msyh.ttc）。"
  }
}
